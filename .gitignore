node_modules
tests/node_modules
tests/shots
# 그림·소리·글꼴 원본(게임은 가공본만 쓴다)
assets/raw
tools/fonts_src
tools/music_src
tools/voice_cache
__pycache__
*.log
# 설계 작업 폴더(설계 문서·작업 사본은 이 컴퓨터에만 둔다)
.dryforge
